---
import '../styles/pirates-game.css';
import GameIntroduction from '../components/economy/GameIntroduction.astro';
import PolicySimulator from '../components/economy/PolicySimulator.astro';
import ModelNotes from '../components/economy/ModelNotes.astro';
import Sources from '../components/economy/Sources.astro';
export const prerender = true;
const title = 'When AI does the work, how would rational voters respond?';
const description = 'Simulate how perfectly rational, self-interested voters would choose AI pace, job protections, benefits and taxes after AI automation, with or without international competition.';
const canonical = new URL('/', Astro.site ?? 'https://ai-pirates-game.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Pirate’s Game · {title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ea" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="AI Pirate’s Game" />
    <meta property="og:title" content={`AI Pirate’s Game · ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#simulator">Skip to simulator</a>
    <header class="site-header page-width"><a href="/">AI Pirate’s Game</a><a href="#notes">About the model</a></header>
    <main class="page-width">
      <GameIntroduction />
      <PolicySimulator />
      <ModelNotes />
      <Sources />
    </main>
    <footer class="page-width site-footer"><a href="https://sokolsky.me">Nikita Sokolsky</a><span>September 2026 · One ballot, ten years</span></footer>
    <script>import '../components/economy/pirates-game';</script>
  </body>
</html>
