<div class="result-column">
  <p id="computation-message" class="computation-message" role="status" aria-live="polite">Calculating…</p>
  <div class="results" id="results" aria-busy="true">
    <div class="result-heading"><p class="eyebrow" id="result-label">The simulated outcome</p><span class="status" id="solve-status"></span></div>
    <section class="ballot-result" aria-labelledby="ballot-verdict">
      <h2 id="ballot-verdict">Counting the votes…</h2>
      <p id="ballot-support"></p>
      <p id="ballot-leading" class="small-copy" hidden></p>
    </section>
    <div id="policy-decisions" class="policy-decisions" role="group" aria-label="Six terms of the enacted policy">
      <p class="small-copy">Comparing AI pace, job retention, benefit amounts, benefit rules and taxes.</p>
    </div>
    <p id="decision-votes-note" class="decision-summary"></p>
    <div id="policy-strip" class="policy-strip"></div>
    <p id="policy-meaning" class="small-copy"></p>
    <p id="growth-summary" class="small-copy"></p>
    <div id="funding-verdict" class="funding-verdict"></div>

    <figure class="income-figure">
      <figcaption><h3>What people take home</h3><p>Income after tax, including pay, government benefits and capital income. Each group’s income before AI = 100.</p><p id="workforce-summary"></p></figcaption>
      <div class="legend"><span class="worker">Obsolete roles</span><span class="owner">Productive roles</span><span class="output">All adult citizens</span></div>
      <div id="income-chart" class="chart" role="img" aria-label="Ten-year income projection"></div>
      <div id="endpoints" class="endpoints"></div>
      <details class="chart-data"><summary>Read the chart as a table</summary><div class="table-scroll" tabindex="0" role="region" aria-label="Income by year"><table><caption>Income relative to each group’s starting income</caption><thead><tr><th scope="col">Year</th><th scope="col">Workers affected</th><th scope="col">Income: obsolete roles</th><th scope="col">Income: productive roles</th><th scope="col">All adult citizens</th></tr></thead><tbody id="year-table"></tbody></table></div></details>
    </figure>

    <section id="international-result" class="international-result" hidden aria-labelledby="international-heading">
      <h3 id="international-heading">The foreign response</h3>
      <div id="country-policies" class="country-policies"></div>
      <p id="equilibrium-explanation"></p>
      <div id="deviation" class="deviation"></div>
    </section>

    <details class="result-details alternatives">
      <summary>Compare alternatives</summary>
      <section class="ballot-tallies" aria-labelledby="ballot-table-heading"><h3 id="ballot-table-heading">Which packages get the votes?</h3><p id="ballot-table-note" class="small-copy"></p><div class="table-scroll" tabindex="0" role="region" aria-label="Complete-package ballot results"><table class="ballot-table"><thead><tr><th scope="col">Complete policy package</th><th scope="col">First-choice votes</th></tr></thead><tbody id="ballot-table"></tbody></table></div></section>
      <section class="comparison-section" aria-labelledby="comparison-heading"><h3 id="comparison-heading">Income and output in year ten</h3><p class="small-copy">Starting values = 100. Policies can change several decisions together.</p><div class="table-scroll" tabindex="0" role="region" aria-label="Compare policy packages"><table class="comparison-table"><thead><tr><th scope="col">Policy</th><th scope="col">All citizens</th><th scope="col">Mainly work income</th><th scope="col">Mainly capital income</th><th scope="col">Output</th></tr></thead><tbody id="comparison-table"></tbody></table></div><p id="score-help" class="small-copy"></p></section>
    </details>

    <details class="result-details manual-policy"><summary>Try your own US policy</summary><p id="manual-help" class="small-copy">Choose AI pace, job retention, the benefit budget, the benefit formula and both tax rates. Foreign policy stays fixed.</p><div id="manual-inputs"></div><button type="button" id="apply-manual">Compare with the selected policy</button><p id="manual-result" role="status"></p></details>
    <details class="result-details accounting"><summary>Follow the money in year ten</summary><p class="small-copy">Year-ten income flows under the selected policy. Transfers change who receives income.</p><div class="table-scroll" tabindex="0" role="region" aria-label="Year ten income accounting"><table><tbody id="accounting-table"></tbody></table></div><p id="ownership-note" class="small-copy"></p></details>
    <details class="result-details vote-audit"><summary>Voting details and tie-breaking</summary><p id="selection-explanation" class="small-copy"></p><div id="agenda-order" class="small-copy"></div></details>
    <div class="result-actions"><button type="button" id="share" class="text-button">Copy scenario link</button><button type="button" id="download" class="text-button">Download results</button><span id="action-status" role="status"></span></div>
  </div>
</div>
