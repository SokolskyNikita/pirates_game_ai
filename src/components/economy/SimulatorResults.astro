<div class="result-column">
  <p id="computation-message" class="computation-message" role="status" aria-live="polite">Calculating…</p>
  <div class="results" id="results" aria-busy="true">
    <div class="result-heading"><p class="eyebrow" id="result-label">The simulated outcome</p><span class="status" id="solve-status"></span></div>
    <section class="ballot-result" aria-labelledby="ballot-verdict">
      <h2 id="ballot-verdict">Counting the votes…</h2>
      <p id="ballot-support"></p>
      <p id="coordination-summary" class="small-copy"></p>
      <p id="ballot-leading" class="small-copy" hidden></p>
    </section>
    <div id="policy-decisions" class="policy-decisions" role="group" aria-label="Terms of the enacted policy">
      <p class="small-copy">Comparing AI pace, job retention, benefit amounts, benefit rules and taxes.</p>
    </div>
    <p id="decision-votes-note" class="decision-summary"></p>
    <div id="policy-strip" class="policy-strip"></div>
    <p id="policy-meaning" class="small-copy"></p>
    <p id="growth-summary" class="small-copy"></p>
    <div id="funding-verdict" class="funding-verdict"></div>

    <figure class="income-figure">
      <figcaption><h3 id="income-heading">What people take home</h3><p>Household income after tax and consumer-price changes, including pay, government benefits and capital income. Each group’s income before AI = 100.</p><p id="workforce-summary"></p></figcaption>
      <div class="legend"><span class="worker">Outside productive jobs</span><span class="owner">In productive jobs</span><span class="output">All adult citizens</span></div>
      <div id="income-chart" class="chart" role="img" aria-label="Ten-year income projection" aria-describedby="chart-note"></div>
      <p id="chart-note" class="chart-note"></p>
      <div id="endpoints" class="endpoints"></div>
      <details class="chart-data"><summary>Read the chart as a table</summary><div class="table-scroll" tabindex="0" role="region" aria-label="Income by year"><table><caption>Income relative to each group’s starting income</caption><thead><tr><th scope="col">Year</th><th scope="col">Outside productive jobs</th><th scope="col">Income: outside productive jobs</th><th scope="col">Income: in productive jobs</th><th scope="col">All adult citizens</th></tr></thead><tbody id="year-table"></tbody></table></div></details>
    </figure>

    <section id="international-result" class="international-result" hidden aria-labelledby="international-heading">
      <div class="result-heading"><p class="eyebrow">The rest of the world</p></div>
      <div class="ballot-result">
        <h2 id="international-heading">The foreign choice</h2>
        <p id="foreign-policy-objective"></p>
      </div>
      <div id="foreign-policy-decisions" class="policy-decisions" role="group" aria-label="Seven terms of foreign policy"></div>
      <div id="foreign-policy-strip" class="policy-strip"></div>
      <p id="foreign-reference-note" class="small-copy"></p>
      <h3 id="trade-verdict"></h3>
      <p id="trade-impact"></p>
      <div id="deviation" class="deviation"></div>
      <details class="chart-data"><summary>How the two choices are related</summary>
        <p id="equilibrium-explanation" class="small-copy"></p>
      </details>
    </section>

    <details class="result-details vote-audit"><summary>Voting details and tie-breaking</summary><p id="selection-explanation" class="small-copy"></p><div id="agenda-order" class="small-copy"></div></details>
    <div class="result-actions"><button type="button" id="download" class="text-button">Download results</button><span id="action-status" role="status"></span></div>
  </div>
</div>
