{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-pirates-game",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "ai-pirates-game.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ai-pirates-game.com",
      "custom_domain": true
    }
  ]
}
