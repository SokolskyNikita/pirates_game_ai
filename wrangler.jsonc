{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-pirates-game",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ai-pirates-game.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ai-pirates-game.com",
      "custom_domain": true
    }
  ],
  "main": ".build/python/worker.py",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "calculator/data/*.json"
      ],
      "fallthrough": true
    }
  ],
  "limits": {
    "cpu_ms": 300000
  }
}
