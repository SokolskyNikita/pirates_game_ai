{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-pirates-game",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ai-pirates-game.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ai-pirates-game.com",
      "custom_domain": true
    }
  ],
  "main": "worker/static.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 50
  }
}
